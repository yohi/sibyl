{
  "name": "@yohi/sibyl",
  "version": "0.1.0",
  "description": "OpenTUI + PTY multi-pane plugin for OpenCode",
  "type": "module",
  "files": ["dist/", "src/", "biome.json", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "bun test && bun test --conditions=browser --preload @opentui/solid/preload ./tests/pane-render.integration.tsx ./tests/pty-render-latency.integration.tsx",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "opencode": "^1.18.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.8",
    "@opentui/core": ">=0.4.5 <1",
    "@opentui/keymap": ">=0.4.5 <1",
    "@opentui/solid": ">=0.4.5 <1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.26.0",
    "@biomejs/biome": "^1.9.4",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@types/bun": "1.3.14",
    "babel-preset-solid": "^1.9.9",
    "@opentui/solid": ">=0.4.5 <1",
    "rollup": "^4.28.0",
    "typescript": "^7.0.2"
  }
}
