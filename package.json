{
  "name": "@yohi/sibyl",
  "version": "3.0.0",
  "description": "Read-only OpenCode sidebar observer for direct child-agent sessions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohi/sibyl.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/",
    "src/",
    "biome.json",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "CHANGELOG.md",
    "docs/architecture.md",
    "docs/migration.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui-v2.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/clean-dist.mjs && tsc --emitDeclarationOnly && rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "bun test --path-ignore-patterns 'tests/subagent-observer.test.tsx' --path-ignore-patterns 'tests/opencode-v2-sidebar.test.tsx' --path-ignore-patterns 'tests/opencode-v2-entry.test.ts' && bun test --conditions=browser --preload @opentui/solid/preload ./tests/subagent-observer.test.tsx ./tests/opencode-v2-sidebar.test.tsx ./tests/opencode-v2-entry.test.ts ./tests/pane-render.integration.tsx ./tests/pty-render-latency.integration.tsx",
    "test:coverage": "bun test --coverage --coverage-dir=coverage/unit --coverage-reporter=lcov --path-ignore-patterns 'tests/subagent-observer.test.tsx' --path-ignore-patterns 'tests/opencode-v2-sidebar.test.tsx' --path-ignore-patterns 'tests/opencode-v2-entry.test.ts' && bun test --coverage --coverage-dir=coverage/browser --coverage-reporter=lcov --conditions=browser --preload @opentui/solid/preload ./tests/subagent-observer.test.tsx ./tests/opencode-v2-sidebar.test.tsx ./tests/opencode-v2-entry.test.ts ./tests/pane-render.integration.tsx ./tests/pty-render-latency.integration.tsx",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "opencode": ">=2.1.4 <3"
  },
  "devEngines": {
    "runtime": {
      "name": "opencode",
      "version": "2.1.4",
      "onFail": "error"
    }
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.4 <3",
    "@opentui/core": ">=0.6.8 <1",
    "@opentui/keymap": ">=0.6.8 <1",
    "@opentui/solid": ">=0.6.8 <1",
    "solid-js": ">=1.9.0 <2"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.23.3",
    "@biomejs/biome": "^2.5.6",
    "@opencode/client": "2.1.4",
    "@opencode/plugin": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/keymap": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/bun": "1.3.14",
    "babel-preset-solid": "^1.9.9",
    "rollup": "^4.28.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@babel/core": "^7.23.3"
  },
  "overrides": {
    "seroval": "^1.6.10",
    "seroval-plugins": "^1.6.10"
  }
}
