{
  "name": "@yohi/sibyl",
  "version": "1.1.0",
  "description": "Read-only OpenCode sidebar observer for direct child-agent sessions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohi/sibyl.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/",
    "src/",
    "biome.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "bun test --path-ignore-patterns 'tests/subagent-observer.test.tsx' --path-ignore-patterns 'tests/subagent-integration.test.ts' && bun test --conditions=browser --preload @opentui/solid/preload ./tests/subagent-observer.test.tsx ./tests/subagent-integration.test.ts ./tests/pane-render.integration.tsx ./tests/pty-render-latency.integration.tsx",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --path-ignore-patterns 'tests/subagent-observer.test.tsx' --path-ignore-patterns 'tests/subagent-integration.test.ts' && bun test --coverage --coverage-reporter=lcov --conditions=browser --preload @opentui/solid/preload ./tests/subagent-observer.test.tsx ./tests/subagent-integration.test.ts ./tests/pane-render.integration.tsx ./tests/pty-render-latency.integration.tsx",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "opencode": "^1.18.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.8",
    "@opentui/core": ">=0.4.5 <1",
    "@opentui/keymap": ">=0.4.5 <1",
    "@opentui/solid": ">=0.4.5 <1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.23.3",
    "@biomejs/biome": "^2.5.6",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/bun": "1.3.14",
    "babel-preset-solid": "^1.9.9",
    "@opentui/solid": ">=0.4.5 <1",
    "rollup": "^4.28.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@babel/core": "^7.23.3"
  }
}
